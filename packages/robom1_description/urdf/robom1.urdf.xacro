<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robom1">
  <xacro:arg name="wheelbase" default="0.52"/>
  <xacro:arg name="track" default="0.48"/>
  <xacro:arg name="wheel_radius" default="0.09"/>
  <xacro:arg name="racket_pivot_x" default="0.05"/>
  <xacro:property name="racket_pivot_x" value="$(arg racket_pivot_x)"/>
  <xacro:arg name="racket_pivot_y" default="-0.36"/>
  <xacro:property name="racket_pivot_y" value="$(arg racket_pivot_y)"/>
  <xacro:arg name="racket_pivot_z" default="1.05"/>
  <xacro:property name="racket_pivot_z" value="$(arg racket_pivot_z)"/>
  <xacro:arg name="racket_reach" default="0.62"/>
  <xacro:property name="racket_reach" value="$(arg racket_reach)"/>
  <xacro:arg name="racket_radius" default="0.14"/>
  <xacro:property name="racket_radius" value="$(arg racket_radius)"/>
  <xacro:arg name="racket_thickness" default="0.015"/>
  <xacro:property name="racket_thickness" value="$(arg racket_thickness)"/>
  <xacro:property name="wb" value="$(arg wheelbase)"/>
  <xacro:property name="tw" value="$(arg track)"/>
  <xacro:property name="wr" value="$(arg wheel_radius)"/>
  <material name="blue"><color rgba="0.08 0.3 0.8 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.1 1"/></material>
  <material name="silver"><color rgba="0.7 0.75 0.8 1"/></material>
  <material name="orange"><color rgba="1 0.4 0.05 1"/></material>
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial><mass value="${mass}"/><inertia ixx="${mass*(y*y+z*z)/12}" ixy="0" ixz="0"
      iyy="${mass*(x*x+z*z)/12}" iyz="0" izz="${mass*(x*x+y*y)/12}"/></inertial>
  </xacro:macro>
  <xacro:macro name="box_link" params="name size mass color">
    <link name="${name}">
      <visual><geometry><box size="${size}"/></geometry><material name="${color}"/></visual>
      <collision><geometry><box size="${size}"/></geometry></collision>
      <xacro:box_inertia mass="${mass}" x="${float(size.split()[0])}" y="${float(size.split()[1])}" z="${float(size.split()[2])}"/>
    </link>
  </xacro:macro>
  <link name="base_footprint"/>
  <xacro:box_link name="base_link" size="0.64 0.44 0.16" mass="18.0" color="blue"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.22"/></joint>
  <xacro:macro name="wheel" params="name x y">
    <xacro:box_link name="${name}_steer_link" size="0.06 0.06 0.06" mass="0.3" color="orange"/>
    <joint name="${name}_steer_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_steer_link"/>
      <origin xyz="${x} ${y} ${wr-0.22}"/><axis xyz="0 0 1"/><limit effort="20" velocity="4"/>
    </joint>
    <link name="${name}_wheel_link">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wr}" length="0.045"/></geometry><material name="black"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wr}" length="0.045"/></geometry></collision>
      <inertial><mass value="0.5"/><inertia ixx="${0.5*(3*wr*wr+0.045*0.045)/12}" ixy="0" ixz="0"
        iyy="${0.5*wr*wr/2}" iyz="0" izz="${0.5*(3*wr*wr+0.045*0.045)/12}"/></inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous"><parent link="${name}_steer_link"/>
      <child link="${name}_wheel_link"/><axis xyz="0 1 0"/><limit effort="20" velocity="40"/></joint>
  </xacro:macro>
  <xacro:wheel name="front_left" x="${wb/2}" y="${tw/2}"/>
  <xacro:wheel name="front_right" x="${wb/2}" y="${-tw/2}"/>
  <xacro:wheel name="rear_left" x="${-wb/2}" y="${tw/2}"/>
  <xacro:wheel name="rear_right" x="${-wb/2}" y="${-tw/2}"/>
  <xacro:box_link name="mast_link" size="0.05 0.05 0.7" mass="1.0" color="silver"/>
  <joint name="mast_joint" type="fixed"><parent link="base_link"/><child link="mast_link"/><origin xyz="0 0 0.43"/></joint>
  <!-- Absolute sensor positions: camera (0.12,0,1.0), lidar (0.18,0,0.90). -->
  <xacro:box_link name="camera_link" size="0.06 0.10 0.04" mass="0.1" color="black"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.12 0 0.78"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="${-pi/2} 0 ${-pi/2}"/></joint>
  <xacro:box_link name="lidar_link" size="0.07 0.07 0.06" mass="0.2" color="orange"/>
  <!-- Positive pitch raises the beam: rotation about NEGATIVE y. -->
  <joint name="lidar_pitch_joint" type="revolute"><parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.18 0 0.68"/><axis xyz="0 -1 0"/>
    <limit lower="-0.6" upper="1.2" effort="4" velocity="1.5"/>
  </joint>
  <!-- Grip-end pivot: local +z points from grip to head. Positive +y pitch
       sweeps the head forward (+x), then down through the follow-through. -->
  <link name="racket_handle_link">
    <visual><origin xyz="0 0 0.25"/><geometry><box size="0.025 0.025 0.5"/></geometry><material name="silver"/></visual>
    <visual><origin xyz="0 0 0.06"/><geometry><box size="0.04 0.04 0.12"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0.25"/><geometry><box size="0.025 0.025 0.5"/></geometry></collision>
    <inertial><origin xyz="0 0 0.25"/><mass value="0.1"/>
      <inertia ixx="0.00208854" ixy="0" ixz="0" iyy="0.00208854" iyz="0" izz="0.00001042"/></inertial>
  </link>
  <joint name="racket_swing_joint" type="revolute"><parent link="base_link"/><child link="racket_handle_link"/>
    <origin xyz="${racket_pivot_x} ${racket_pivot_y} ${float(racket_pivot_z)-0.22}"/><axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="2.0" effort="10" velocity="8"/>
  </joint>
  <link name="racket_head_link">
    <visual><origin rpy="0 ${pi/2} 0"/><geometry><cylinder radius="${racket_radius}" length="${racket_thickness}"/></geometry><material name="orange"/></visual>
    <collision><origin rpy="0 ${pi/2} 0"/><geometry><cylinder radius="${racket_radius}" length="${racket_thickness}"/></geometry></collision>
    <xacro:box_inertia mass="0.08" x="${racket_thickness}" y="${2*float(racket_radius)}" z="${2*float(racket_radius)}"/>
  </link>
  <joint name="racket_head_joint" type="fixed"><parent link="racket_handle_link"/><child link="racket_head_link"/><origin xyz="0 0 ${racket_reach}"/></joint>
</robot>
